@model PersonalFinanceTracker.Models.ViewModels.DashboardViewModel

<h2 class="mb-3">Welcome back 👋</h2>

<div class="row g-3">

    <div class="col-md-4">
        <div class="card p-4">
            <div class="text-muted">Balance</div>
            <h2 class="balance">@Model.Balance</h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-4">
            <div class="text-muted">Income</div>
            <h2 class="income">+@Model.TotalIncome</h2>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-4">
            <div class="text-muted">Expenses</div>
            <h2 class="expense">-@Model.TotalExpense</h2>
        </div>
    </div>

</div>

<div class="card mt-4 p-4">
    <h6>Income vs Expenses</h6>
    <div style="height: 220px;">
        <canvas id="chart"></canvas>
    </div>
</div>

@section Scripts {
    <script>
        new Chart(document.getElementById('chart'), {
            type: 'doughnut',
            data: {
                labels: ['Income', 'Expenses'],
                datasets: [{
                    data: [@Model.TotalIncome, @Model.TotalExpense],
                    backgroundColor: ['#22c55e', '#ef4444']
                }]
            },
            options: {
                maintainAspectRatio: false
            }
        });
    </script>
}