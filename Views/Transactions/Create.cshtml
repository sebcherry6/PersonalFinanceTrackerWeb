@model PersonalFinanceTracker.Models.Transaction

<form asp-action="Create" method="post">

    <input asp-for="Amount" class="form-control" placeholder="Amount" />

    <input asp-for="Description" class="form-control" placeholder="Description" />

    <select asp-for="TransactionType" class="form-control">
        <option value="Income">Income</option>
        <option value="Expense">Expense</option>
    </select>

    <select asp-for="Category" class="form-control"
            asp-items="Html.GetEnumSelectList<PersonalFinanceTracker.Models.Category>()">
    </select>

    <button type="submit" class="btn btn-primary">Save</button>

</form>