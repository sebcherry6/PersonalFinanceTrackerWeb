@model PersonalFinanceTracker.Models.Transaction

<h2>Delete Transaction</h2>

<div class="card p-4 mt-3">

    <h5>Are you sure you want to delete this?</h5>

    <ul>
        <li><b>Amount:</b> @Model.Amount</li>
        <li><b>Description:</b> @Model.Description</li>
        <li><b>Category:</b> @Model.Category</li>
        <li><b>Date:</b> @Model.Date</li>
    </ul>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Yes, Delete
        </button>

        <a href="/Transactions/Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>

</div>