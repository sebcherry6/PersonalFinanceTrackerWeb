@model PersonalFinanceTracker.Models.Transaction

<h2>Edit Transaction</h2>

<div class="card p-4 mt-3">

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label>Amount</label>
            <input asp-for="Amount" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Description</label>
            <input asp-for="Description" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Category</label>
            <select asp-for="Category" class="form-control"
                    asp-items="Html.GetEnumSelectList<PersonalFinanceTracker.Models.Category>()">
            </select>
        </div>

        <div class="mb-3">
            <label>Type</label>
            <select asp-for="TransactionType" class="form-control"
                    asp-items="Html.GetEnumSelectList<PersonalFinanceTracker.Models.TransactionType>()">
            </select>
        </div>

        <button class="btn btn-success">Save</button>

    </form>

</div>