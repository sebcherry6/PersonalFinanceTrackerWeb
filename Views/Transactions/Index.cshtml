@model List<PersonalFinanceTracker.Models.Transaction>

<h2>Transactions</h2>

<div class="card p-3 mt-3">

    <table class="table table-dark table-hover">

        <thead>
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Category</th>
                <th>Description</th>
                <th>Amount</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Date.ToShortDateString()</td>

                    <td>
                        @if (t.TransactionType.ToString() == "Income")
                        {
                            <span class="income">Income</span>
                        }
                        else
                        {
                            <span class="expense">Expense</span>
                        }
                    </td>

                    <td>@t.Category</td>
                    <td>@t.Description</td>

                    <td>
                        @(t.TransactionType == PersonalFinanceTracker.Models.TransactionType.Income
                            ? "+" + t.Amount
                            : "-" + t.Amount)
                    </td>
                    <td>
                        <a class="btn btn-sm btn-warning" href="/Transactions/Edit/@t.Id">Edit</a>
                        <a class="btn btn-sm btn-danger" href="/Transactions/Delete/@t.Id">Delete</a>
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>