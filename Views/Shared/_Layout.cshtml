@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>FinanceTracker by WebCherry</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
        --bg: #0b1220;
        --card: #111827;
        --text: #e5e7eb;
        --muted: #9ca3af;
        --accent: #60a5fa;
        --income: #22c55e;
        --expense: #ef4444;
        }

        body.light {
        --bg: #f8fafc;
        --card: #ffffff;
        --text: #0f172a;
        --muted: #475569;
        --accent: #2563eb;
        --income: #16a34a;
        --expense: #dc2626;
        }

        body {
        background: var(--bg);
        color: var(--text);
        transition: 0.25s ease;
        }

        .sidebar {
        width: 240px;
        position: fixed;
        height: 100vh;
        background: var(--card);
        padding: 20px;
        border-right: 1px solid rgba(255,255,255,0.05);
        }

        .main {
        margin-left: 260px;
        padding: 25px;
        }

        .card {
        background: var(--card);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 14px;
        color: var(--text);
        }

        a {
        color: var(--text);
        text-decoration: none;
        }

        a:hover {
        color: var(--accent);
        }

        .income {
        color: var(--income);
        }

        .expense {
        color: var(--expense);
        }

        .balance {
        color: var(--accent);
        }

        .nav-item {
        margin: 10px 0;
        }
    </style>
</head>

<body>

    <div class="sidebar">

        <div class="mb-4 d-flex align-items-center">
            <img src="/img/cherry-logo.svg" width="40" />
            <div class="ms-2">
                <strong>FinanceTracker</strong><br />
                <small>by WebCherry</small>
            </div>
        </div>

        @if (SignInManager.IsSignedIn(User))
        {
            <div class="nav-item"><a href="/Transactions/Dashboard">📊 Dashboard</a></div>
            <div class="nav-item"><a href="/Transactions/Index">💳 Transactions</a></div>
            <div class="nav-item"><a href="/Transactions/Create">➕ Add</a></div>

            <hr />

            <button class="btn btn-sm btn-outline-light w-100 mb-2" onclick="toggleTheme()">
                🌗 Theme
            </button>

            <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                <button class="btn btn-sm btn-danger w-100">Logout</button>
            </form>
        }
        else
        {
            <a class="btn btn-success w-100" href="/Identity/Account/Login">Login</a>
        }

    </div>

    <div class="main">
        @RenderBody()
    </div>

    <script>
        function toggleTheme() {
        document.body.classList.toggle("light");
        localStorage.setItem("theme",
        document.body.classList.contains("light") ? "light" : "dark");
        }

        (function () {
        if (localStorage.getItem("theme") === "light") {
        document.body.classList.add("light");
        }
        })();
    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>