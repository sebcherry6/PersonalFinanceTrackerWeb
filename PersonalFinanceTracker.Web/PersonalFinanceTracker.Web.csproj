<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    FinanceTracker by WebCherry - web app project.

    Removed vs the original:
      * Microsoft.AspNetCore.Identity.UI - the default Identity pages were never wired up
        (no AddDefaultUI / MapRazorPages), so it only added unused attack surface.
      * Microsoft.VisualStudio.Web.CodeGeneration.Design - a scaffolding tool that was being
        shipped in bin/ (Roslyn, NuGet, MSBuild... ~40 MB). Re-add it temporarily if you
        ever want to scaffold again, then remove it.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PersonalFinanceTracker.Web</RootNamespace>
    <!-- Treat nullable warnings as errors so "might be null" bugs can't slip through. -->
    <WarningsAsErrors>nullable</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />

    <!--
      Security pin: EF Core 10.0.9 pulls in SQLitePCLRaw.lib.e_sqlite3 2.1.11, which bundles a
      SQLite build affected by GHSA-2m69-gcr7-jv3q (CVE-2025-6965). 3.50.3 is the same package
      rebuilt with patched SQLite (its version now tracks the SQLite version). Remove this line
      once a newer EF Core release depends on a fixed version by itself.
    -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The local database is runtime data, never part of a build or publish. -->
  <ItemGroup>
    <None Remove="App_Data/**" />
    <Content Remove="App_Data/**" />
  </ItemGroup>

</Project>
